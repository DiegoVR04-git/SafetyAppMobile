<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SafetyAppMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SafetyAppMobile"
    Title="Pulso Violeta"
    Shell.NavBarIsVisible="False"
    FlyoutBehavior="Disabled">
    <!-- 👆 FlyoutBehavior="Disabled" apaga completamente el menú de hamburguesa -->

    <!-- ========================================== -->
    <!-- ESTILOS DE LA BARRA INFERIOR               -->
    <!-- ========================================== -->
    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="TabBar">
                <Setter Property="Shell.TabBarBackgroundColor" Value="White" />
                <Setter Property="Shell.TabBarTitleColor" Value="#37246B" />
                <!-- Tu morado oscuro para el tab activo -->
                <Setter Property="Shell.TabBarUnselectedColor" Value="#B39DDB" />
                <!-- Morado claro/gris para inactivos -->
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- ========================================== -->
    <!-- ZONA PÚBLICA (Sin Menú Inferior)           -->
    <!-- ========================================== -->
    <!-- Al poner Shell.TabBarIsVisible="False", aseguramos que en estas pantallas no salga la barra -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="login" 
        Shell.TabBarIsVisible="False" />

    <ShellContent
        Title="Onboarding"
        ContentTemplate="{DataTemplate local:OnboardingPage}"
        Route="onboarding" 
        Shell.TabBarIsVisible="False" />

    <!-- ========================================== -->
    <!-- ZONA PRIVADA (Barra de Pestañas Inferior)  -->
    <!-- ========================================== -->
    <TabBar Route="main">

        <!-- Sin propiedad Title, el ícono se centra automáticamente -->
        <Tab Icon="dashboard_icon.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:DashboardPage}"
                Route="dashboard" />
        </Tab>

        <Tab Icon="contacts_icon.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:ContactPage}"
                Route="contacts" />
        </Tab>

        <Tab Icon="profile_icon.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:ProfilePage}"
                Route="profile" />
        </Tab>

    </TabBar>

</Shell>