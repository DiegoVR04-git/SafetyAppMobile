<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="SafetyAppMobile.LoginPage"
             Title="Iniciar Sesión"
             BackgroundColor="{StaticResource PulsoFondo}">
    <!-- 🟣 Fondo oficial de Pulso Violeta -->

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

            <!-- Ícono decorativo -->
            <skia:SKLottieView Source="UserShield.json"
                               RepeatCount="-1"
                               HeightRequest="96"
                               WidthRequest="96"
                               HorizontalOptions="Center" />

            <!-- Título de Bienvenida -->
            <Label Text="Bienvenido de vuelta" 
                   FontSize="28" 
                   FontFamily="PoppinsBold"
                   FontAttributes="Bold" 
                   TextColor="{StaticResource PulsoMoradoProfundo}"
                   HorizontalOptions="Center" />

            <!-- Subtítulo -->
            <Label Text="Ingresa tus datos para acceder a tu red de seguridad." 
                   FontSize="14" 
                   FontFamily="PoppinsRegular"
                   TextColor="{StaticResource PulsoMoradoMedio}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>

            <!-- 🃏 Tarjeta Blanca para el Formulario de Login -->
            <Frame BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <Grid ColumnDefinitions="85, *" ColumnSpacing="10" Margin="0,0,0,15">

                        <!-- Selector de País -->
                        <Picker x:Name="CountryCodePicker" 
                                Grid.Column="0" 
                                Title="País" 
                                TextColor="{StaticResource PulsoMoradoProfundo}"
                                TitleColor="{StaticResource PulsoMoradoMedio}"
                                FontFamily="PoppinsRegular"
                                BackgroundColor="Transparent"
                                SelectedIndex="0">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>+52</x:String>
                                    <x:String>+1</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <!-- Entrada de Teléfono -->
                        <Entry x:Name="PhoneEntry" 
                               Grid.Column="1"
                               Placeholder="Número (10 dígitos)" 
                               MaxLength="10"
                               Keyboard="Telephone"
                               PlaceholderColor="{StaticResource PulsoMoradoMedio}"
                               TextColor="{StaticResource PulsoMoradoProfundo}"
                               FontFamily="PoppinsRegular"
                               BackgroundColor="Transparent"/>
                    </Grid>

                    <!-- Entrada de Contraseña -->
                    <Entry x:Name="PasswordEntry" 
                           Placeholder="Contraseña" 
                           IsPassword="True" 
                           PlaceholderColor="{StaticResource PulsoMoradoMedio}"
                           TextColor="{StaticResource PulsoMoradoProfundo}"
                           FontFamily="PoppinsRegular"
                           BackgroundColor="Transparent"/>

                    <!-- Checkbox de "Mantener Sesión" -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5,0,0" VerticalOptions="Center">
                        <!-- El Checkbox ahora usa el Morado Profundo en lugar del verde genérico -->
                        <CheckBox x:Name="RememberMeCheckBox" Color="{StaticResource PulsoMoradoProfundo}" IsChecked="True"/>
                        <Label Text="Mantener sesión iniciada" 
                               TextColor="{StaticResource PulsoMoradoMedio}" 
                               FontFamily="PoppinsRegular"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Botón de Entrar -->
            <Button x:Name="LoginBtn"
                    Text="Entrar" 
                    Clicked="OnLoginClicked"
                    BackgroundColor="{StaticResource PulsoMoradoProfundo}" 
                    TextColor="{StaticResource PulsoFondo}" 
                    FontSize="18"
                    FontFamily="PoppinsBold"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,10,0,0"/>

            <!-- Label de Error -->
            <Label x:Name="StatusLabel"
                   Text=""
                   TextColor="{StaticResource PulsoAlertaRoja}"
                   HorizontalOptions="Center"
                   FontFamily="PoppinsBold"
                   FontAttributes="Bold"/>

            <!-- Enlace para Registrarse -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,20,0,0">
                <Label Text="¿No tienes cuenta?" TextColor="{StaticResource PulsoMoradoMedio}" FontFamily="PoppinsRegular" VerticalOptions="Center"/>
                <Label Text="Regístrate" 
                       TextColor="{StaticResource PulsoMoradoProfundo}" 
                       FontFamily="PoppinsBold"
                       FontAttributes="Bold" 
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>