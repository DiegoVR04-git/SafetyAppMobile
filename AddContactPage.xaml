<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafetyAppMobile.AddContactPage"
             Title="Nuevo Protector"
             BackgroundColor="{StaticResource PulsoFondo}">
    <!-- 🟣 Fondo oficial de Pulso Violeta -->

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="25,30,25,30" Spacing="25">

                <!-- Título -->
                <Label Text="Agregar Contacto" 
                       FontSize="24" 
                       FontFamily="PoppinsBold"
                       FontAttributes="Bold" 
                       TextColor="{StaticResource PulsoMoradoProfundo}"
                       HorizontalOptions="Center" />

                <!-- 🃏 Tarjeta Blanca para el Formulario -->
                <Border BackgroundColor="White" 
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 25"
                        Padding="20,25">

                    <Border.Shadow>
                        <Shadow Brush="#D1CBE0" Opacity="0.4" Offset="0,4" Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <!-- 👤 Sección de Foto de Contacto -->
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Border BackgroundColor="#F0EDF9"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 40"
                                    HeightRequest="80" WidthRequest="80"
                                    HorizontalOptions="Center">
                                <Label Text="👤" FontSize="36" TextColor="{StaticResource PulsoMoradoProfundo}" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Agregar foto de contacto" 
                                   TextColor="{StaticResource PulsoMoradoProfundo}" 
                                   FontFamily="PoppinsBold" 
                                   FontSize="13" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Línea divisoria sutil -->
                        <BoxView HeightRequest="1" Color="#F0EDF9" Margin="0,5,0,5"/>

                        <!-- Entrada de Nombre -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nombre (Ej. Mamá)" TextColor="{StaticResource PulsoMoradoMedio}" FontFamily="PoppinsRegular" FontSize="12"/>

                            <Border BackgroundColor="#F4F2FC" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="15,4">
                                <Entry x:Name="NameEntry" 
                                       Placeholder="Escribe el nombre del contacto"
                                       PlaceholderColor="{StaticResource PulsoMoradoMedio}"
                                       TextColor="{StaticResource PulsoMoradoProfundo}"
                                       FontFamily="PoppinsRegular"
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Selector de País y Teléfono (Lado a lado) -->
                        <Grid ColumnDefinitions="0.38*, 0.62*" ColumnSpacing="12">

                            <!-- Selector de Código de País -->
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="País" TextColor="{StaticResource PulsoMoradoMedio}" FontFamily="PoppinsRegular" FontSize="12"/>
                                <Border BackgroundColor="#F4F2FC" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="10,4">
                                    <Picker x:Name="CountryCodePicker" 
                                            Title="País" 
                                            TextColor="{StaticResource PulsoMoradoProfundo}"
                                            TitleColor="{StaticResource PulsoMoradoMedio}"
                                            FontFamily="PoppinsRegular"
                                            BackgroundColor="Transparent"
                                            SelectedIndex="0">
                                        <Picker.Items>
                                            <x:String>+52</x:String>
                                            <x:String>+1</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Entrada de Teléfono -->
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Teléfono (10 dígitos)" TextColor="{StaticResource PulsoMoradoMedio}" FontFamily="PoppinsRegular" FontSize="12"/>
                                <Border BackgroundColor="#F4F2FC" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="15,4">
                                    <Entry x:Name="PhoneEntry"
                                           Placeholder="0000000000" 
                                           MaxLength="10" 
                                           Keyboard="Telephone"
                                           TextColor="{StaticResource PulsoMoradoProfundo}" 
                                           PlaceholderColor="{StaticResource PulsoMoradoMedio}" 
                                           FontFamily="PoppinsRegular"
                                           BackgroundColor="Transparent"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ==============================  ZONA DE BOTONES ============================== -->
                <VerticalStackLayout Spacing="12" Margin="0,5,0,0">

                    <Button x:Name="SaveBtn"
                            Text="Guardar Protector" 
                            Clicked="OnSaveClicked"
                            BackgroundColor="{StaticResource PulsoMoradoProfundo}" 
                            TextColor="{StaticResource PulsoFondo}" 
                            FontSize="16"
                            FontFamily="PoppinsBold"
                            FontAttributes="Bold"
                            CornerRadius="25"
                            HeightRequest="55"/>

                    <Label x:Name="StatusLabel"
                           Text=""
                           TextColor="{StaticResource PulsoAlertaRoja}"
                           HorizontalOptions="Center"
                           FontFamily="PoppinsBold"
                           FontAttributes="Bold"
                           Margin="0,-5,0,-5"/>

                    <Button Text="Cancelar" 
                            Clicked="OnCancelClicked"
                            BackgroundColor="Transparent" 
                            TextColor="{StaticResource PulsoMoradoProfundo}" 
                            FontFamily="PoppinsBold"
                            FontAttributes="Bold"
                            HeightRequest="40"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>