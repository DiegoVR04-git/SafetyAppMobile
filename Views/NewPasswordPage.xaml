<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafetyAppMobile.NewPasswordPage"
             BackgroundColor="#5F42CA"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="25,50,25,30" Spacing="12">
            <VerticalStackLayout Spacing="3">
                <Label Text="Nueva Contraseña" FontFamily="PoppinsBold" FontSize="28" FontAttributes="Bold" TextColor="White" CharacterSpacing="-0.5"/>
                <Label Text="Crea una contraseña segura para tu cuenta." FontFamily="PoppinsRegular" FontSize="14" TextColor="#E2D9F3" LineHeight="1.4"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Border Grid.Row="1" BackgroundColor="#F6F3FB" Stroke="Transparent" StrokeShape="RoundRectangle 30,30,0,0" Padding="0">
            <VerticalStackLayout Padding="22,40,22,40" Spacing="20">

                <VerticalStackLayout Spacing="8">
                    <Label Text="NUEVA CONTRASEÑA" TextColor="#7663B5" FontFamily="PoppinsBold" FontSize="11" CharacterSpacing="0.5"/>
                    <Border BackgroundColor="White" Stroke="#E8E5F3" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15,4">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#F4EEFF" Stroke="Transparent" StrokeShape="RoundRectangle 20" HeightRequest="36" WidthRequest="36" VerticalOptions="Center">
                                <Label Text="🔒" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Entry x:Name="PasswordEntry" Grid.Column="1" Placeholder="Mínimo 6 caracteres" IsPassword="True" TextColor="#2D2440" FontFamily="PoppinsRegular" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="CONFIRMAR CONTRASEÑA" TextColor="#7663B5" FontFamily="PoppinsBold" FontSize="11" CharacterSpacing="0.5"/>
                    <Border BackgroundColor="White" Stroke="#E8E5F3" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15,4">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#F4EEFF" Stroke="Transparent" StrokeShape="RoundRectangle 20" HeightRequest="36" WidthRequest="36" VerticalOptions="Center">
                                <Label Text="🔒" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Entry x:Name="ConfirmPasswordEntry" Grid.Column="1" Placeholder="Repite tu contraseña" IsPassword="True" TextColor="#2D2440" FontFamily="PoppinsRegular" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button x:Name="SaveBtn" Text="Guardar y Entrar" Clicked="OnSavePasswordClicked" BackgroundColor="#5F42CA" TextColor="White" FontSize="16" FontFamily="PoppinsBold" FontAttributes="Bold" CornerRadius="25" HeightRequest="55" Margin="0,15,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#5F42CA" Opacity="0.3" Offset="0,6" Radius="10"/>
                    </Button.Shadow>
                </Button>

                <Label x:Name="ErrorLabel" Text="" TextColor="#E5484D" FontFamily="PoppinsBold" FontSize="13" HorizontalOptions="Center" IsVisible="False"/>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>