<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafetyAppMobile.EditContactPage"
             BackgroundColor="#5F42CA"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- CONTENIDO PRINCIPAL DIVIDIDO EN 2 FILAS -->
        <Grid RowDefinitions="Auto,*">

            <!-- ── 1. CABECERA MORADA ──────────────────────────────────────── -->
            <VerticalStackLayout Grid.Row="0"
                                 Padding="25,40,25,30"
                                 Spacing="12">

                <!-- Botón de Regresar con la flecha perfectamente centrada -->
                <HorizontalStackLayout>
                    <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#7458D4" Stroke="Transparent" Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="‹" TextColor="White" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-3,2,0"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Título y Subtítulo -->
                <VerticalStackLayout Spacing="3">
                    <Label Text="Editar Contacto"
                           FontFamily="PoppinsBold"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"
                           CharacterSpacing="-0.5"/>
                    <Label Text="Actualiza la información de tu red de apoyo."
                           FontFamily="PoppinsRegular"
                           FontSize="13"
                           TextColor="#E2D9F3"
                           LineHeight="1.4"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ── 2. TARJETA BLANCA FLOTANTE CON EL FORMULARIO ────────────── -->
            <Border Grid.Row="1"
                    BackgroundColor="#F6F3FB"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 30,30,0,0"
                    Padding="0">

                <ScrollView>
                    <VerticalStackLayout Padding="22,30,22,40" Spacing="22">

                        <!-- 👤 AVATAR CON INICIAL DINÁMICA -->
                        <Grid HorizontalOptions="Center" WidthRequest="90" HeightRequest="90" Margin="0,0,0,5">
                            <Border WidthRequest="84" HeightRequest="84" HorizontalOptions="Center" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="42"/>
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4B2E83" Offset="0"/>
                                        <GradientStop Color="#6C4BC1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label x:Name="AvatarInitials"
                                       Text="M"
                                       TextColor="#FFFFFF"
                                       FontFamily="PoppinsBold"
                                       FontAttributes="Bold"
                                       FontSize="32"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <!-- ── CAMPO 1: NOMBRE COMPLETO ──────────────────── -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="NOMBRE COMPLETO" TextColor="#7663B5" FontFamily="PoppinsBold" FontSize="11" CharacterSpacing="0.5"/>

                            <Border BackgroundColor="White" Stroke="#E8E5F3" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15,6">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="#F4EEFF" Stroke="Transparent" StrokeShape="RoundRectangle 20" HeightRequest="36" WidthRequest="36" VerticalOptions="Center">
                                        <Label Text="👤" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Entry x:Name="NameEntry"
                                           Grid.Column="1"
                                           Placeholder="Ej. Melis"
                                           PlaceholderColor="#B3A8D4"
                                           TextColor="#2D2440"
                                           FontFamily="PoppinsRegular"
                                           FontSize="15"
                                           BackgroundColor="Transparent"
                                           VerticalOptions="Center"
                                           TextChanged="OnNameTextChanged"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ── CAMPO 2: TELÉFONO ─────────────────────────────────────────── -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TELÉFONO" TextColor="#7663B5" FontFamily="PoppinsBold" FontSize="11" CharacterSpacing="0.5"/>

                            <Border BackgroundColor="White" Stroke="#E8E5F3" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15,4">
                                <Grid ColumnDefinitions="Auto, 85, Auto, *" ColumnSpacing="8" VerticalOptions="Center">

                                    <!-- Ícono teléfono -->
                                    <Border Grid.Column="0" BackgroundColor="#F4EEFF" Stroke="Transparent" StrokeShape="RoundRectangle 20" HeightRequest="36" WidthRequest="36" VerticalOptions="Center">
                                        <Label Text="📞" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- 🟣 NUEVO SELECTOR DE PAÍS PERSONALIZADO -->
                                    <Grid Grid.Column="1" HeightRequest="38" VerticalOptions="Center">
                                        <Border BackgroundColor="#F4EEFF" Stroke="Transparent" StrokeShape="RoundRectangle 12" Padding="4,0">
                                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                                <Label x:Name="SelectedCountryCodeLabel" 
                                                       Text="+52" 
                                                       TextColor="#4B2E83"
                                                       FontFamily="PoppinsBold"
                                                       FontSize="14"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="▼" FontSize="10" TextColor="#7663B5" VerticalOptions="Center" Margin="0,0,4,0"/>
                                            </Grid>
                                        </Border>
                                        <!-- Botón transparente para capturar clic -->
                                        <Button BackgroundColor="Transparent" Clicked="OnOpenCountryCodeTapped" />
                                    </Grid>

                                    <!-- Línea sutil -->
                                    <BoxView Grid.Column="2" WidthRequest="1" Color="#E8E5F3" Margin="0,6"/>

                                    <!-- Entrada de Número -->
                                    <Entry x:Name="PhoneEntry"
                                           Grid.Column="3"
                                           Placeholder="5512345678"
                                           PlaceholderColor="#B3A8D4"
                                           TextColor="#2D2440"
                                           FontFamily="PoppinsRegular"
                                           FontSize="15"
                                           MaxLength="10"
                                           Keyboard="Telephone"
                                           VerticalOptions="Center"
                                           BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ── BOTÓN GUARDAR CAMBIOS (Con Clicked conectado) ── -->
                        <Button x:Name="SaveBtn"
                                Text="Guardar Cambios"
                                Clicked="OnSaveClicked"
                                BackgroundColor="#5F42CA"
                                TextColor="White"
                                FontSize="16"
                                FontFamily="PoppinsBold"
                                FontAttributes="Bold"
                                CornerRadius="25"
                                HeightRequest="55"
                                Margin="0,10,0,0">
                            <Button.Shadow>
                                <Shadow Brush="#5F42CA" Opacity="0.3" Offset="0,6" Radius="10"/>
                            </Button.Shadow>
                        </Button>

                        <!-- ── BOTÓN ELIMINAR CONTACTO ───────────────────── -->
                        <Button Text="🗑️ Eliminar Contacto"
                                Clicked="OnDeleteClicked"
                                BackgroundColor="#FEF2F2"
                                TextColor="#E5484D"
                                BorderColor="#FECACA"
                                BorderWidth="1"
                                FontSize="15"
                                FontFamily="PoppinsBold"
                                FontAttributes="Bold"
                                CornerRadius="25"
                                HeightRequest="52"
                                Margin="0,5,0,10"/>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- 🟣 MODAL FLOTANTE PARA SELECCIONAR PAÍS -->
        <Grid x:Name="CountryCodeOverlay" 
              BackgroundColor="#99000000" 
              IsVisible="False" 
              ZIndex="100">
            <Border BackgroundColor="White" 
                    Stroke="#37246B" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20" 
                    HorizontalOptions="Center" 
                    VerticalOptions="Center" 
                    WidthRequest="260" 
                    Padding="25">
                <VerticalStackLayout Spacing="15">
                    <Label Text="País / Región" TextColor="#37246B" FontFamily="PoppinsBold" FontSize="18" HorizontalOptions="Center" Margin="0,0,0,10"/>

                    <Button Text="🇲🇽 +52 (México)" BackgroundColor="#F4EEFF" TextColor="#37246B" FontFamily="PoppinsBold" CornerRadius="12" HeightRequest="50" Clicked="OnCountrySelected"/>
                    <Button Text="🇨🇦 +1 (Canadá / US)" BackgroundColor="#F4EEFF" TextColor="#37246B" FontFamily="PoppinsBold" CornerRadius="12" HeightRequest="50" Clicked="OnCountrySelected"/>

                    <Button Text="Cancelar" BackgroundColor="Transparent" TextColor="#7663B5" FontFamily="PoppinsRegular" Clicked="OnCloseCountryCodeOverlay" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ── 🔴 OVERLAY DE ALERTA DE ELIMINACIÓN ──────────────────────── -->
        <Grid x:Name="CustomDeleteOverlay"
              BackgroundColor="#99000000"
              IsVisible="False"
              Opacity="0"
              ZIndex="100">

            <Border BackgroundColor="White"
                    Stroke="#E5484D"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="25">

                <VerticalStackLayout Spacing="15">
                    <Label Text="⚠️" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="Advertencia"
                           TextColor="#E5484D"
                           FontFamily="PoppinsBold"
                           FontSize="20"
                           HorizontalOptions="Center" />

                    <Label Text="¿Estás seguro de que quieres eliminar a este contacto de tu red de emergencia? Esta acción no se puede deshacer."
                           TextColor="#6F6680"
                           FontFamily="PoppinsRegular"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />

                    <VerticalStackLayout Spacing="10" Margin="0,15,0,0">
                        <Button Text="Sí, Eliminar"
                                BackgroundColor="#E5484D"
                                TextColor="White"
                                CornerRadius="12"
                                FontFamily="PoppinsBold"
                                HeightRequest="50"
                                Clicked="OnConfirmDeleteClicked" />

                        <Button Text="Cancelar"
                                BackgroundColor="Transparent"
                                TextColor="#6F6680"
                                FontFamily="PoppinsRegular"
                                HeightRequest="50"
                                Clicked="OnCancelDeleteAlertClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>