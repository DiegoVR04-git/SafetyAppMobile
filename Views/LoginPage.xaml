<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="SafetyAppMobile.LoginPage"
             Title="Iniciar Sesión"
             BackgroundColor="{StaticResource PulsoFondo}">

    <!-- Envolvemos todo en un Grid principal para poder sobreponer el modal del país -->
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

                <!-- Ícono decorativo -->
                <skia:SKLottieView Source="UserShield.json" RepeatCount="-1" HeightRequest="96" WidthRequest="96" HorizontalOptions="Center" />

                <!-- Título de Bienvenida -->
                <Label Text="Bienvenido de vuelta" FontSize="28" FontFamily="PoppinsBold" FontAttributes="Bold" TextColor="{StaticResource PulsoMoradoProfundo}" HorizontalOptions="Center" />
                <Label Text="Ingresa tus datos para acceder a tu red de seguridad." FontSize="14" FontFamily="PoppinsRegular" TextColor="{StaticResource PulsoMoradoMedio}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,20"/>

                <!-- 🃏 Tarjeta Blanca para el Formulario de Login -->
                <Frame BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True">
                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="95, *" ColumnSpacing="10" Margin="0,0,0,15">

                            <!-- 🟣 NUEVO SELECTOR PERSONALIZADO -->
                            <Grid Grid.Column="0" HeightRequest="48" VerticalOptions="Center">
                                <Border BackgroundColor="{StaticResource PulsoFondo}" 
                                        Stroke="{StaticResource PulsoMoradoMedio}" 
                                        StrokeThickness="1" 
                                        StrokeShape="RoundRectangle 12" 
                                        Padding="8,0">
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <!-- SOLO HAY UN SelectedCountryCodeLabel AQUÍ -->
                                        <Label x:Name="SelectedCountryCodeLabel" 
                                               Text="+52" 
                                               TextColor="{StaticResource PulsoMoradoProfundo}"
                                               FontFamily="PoppinsBold"
                                               FontSize="14"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />

                                        <Label Grid.Column="1" Text="▼" FontSize="10" TextColor="{StaticResource PulsoMoradoMedio}" VerticalOptions="Center" Margin="0,0,4,0"/>
                                    </Grid>
                                </Border>
                                <!-- Botón transparente para atrapar el clic -->
                                <Button BackgroundColor="Transparent" Clicked="OnOpenCountryCodeTapped" />
                            </Grid>

                            <!-- Entrada de Teléfono -->
                            <Border Grid.Column="1" BackgroundColor="{StaticResource PulsoFondo}" Stroke="{StaticResource PulsoMoradoMedio}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="48" VerticalOptions="Center">
                                <Entry x:Name="PhoneEntry" Placeholder="Número (10 dígitos)" MaxLength="10" Keyboard="Telephone" PlaceholderColor="{StaticResource PulsoMoradoMedio}" TextColor="{StaticResource PulsoMoradoProfundo}" FontFamily="PoppinsRegular" FontSize="14" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <!-- Entrada de Contraseña -->
                        <Border BackgroundColor="{StaticResource PulsoFondo}" Stroke="{StaticResource PulsoMoradoMedio}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="48">
                            <Entry x:Name="PasswordEntry" Placeholder="Contraseña" IsPassword="True" PlaceholderColor="{StaticResource PulsoMoradoMedio}" TextColor="{StaticResource PulsoMoradoProfundo}" FontFamily="PoppinsRegular" FontSize="14" BackgroundColor="Transparent" VerticalOptions="Center"/>
                        </Border>

                        <!-- Checkbox de "Mantener Sesión" -->
                        <HorizontalStackLayout Spacing="10" Margin="0,5,0,0" VerticalOptions="Center">
                            <CheckBox x:Name="RememberMeCheckBox" Color="{StaticResource PulsoMoradoProfundo}" IsChecked="True"/>
                            <Label Text="Mantener sesión iniciada" TextColor="{StaticResource PulsoMoradoMedio}" FontFamily="PoppinsRegular" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- Botones y Enlaces -->
                <Button x:Name="LoginBtn" Text="Entrar" Clicked="OnLoginClicked" BackgroundColor="{StaticResource PulsoMoradoProfundo}" TextColor="{StaticResource PulsoFondo}" FontSize="18" FontFamily="PoppinsBold" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Margin="0,10,0,0"/>
                <Label x:Name="StatusLabel" Text="" TextColor="{StaticResource PulsoAlertaRoja}" HorizontalOptions="Center" FontFamily="PoppinsBold" FontAttributes="Bold"/>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,20,0,0">
                    <Label Text="¿No tienes cuenta?" TextColor="{StaticResource PulsoMoradoMedio}" FontFamily="PoppinsRegular" VerticalOptions="Center"/>
                    <Label Text="Regístrate" TextColor="{StaticResource PulsoMoradoProfundo}" FontFamily="PoppinsBold" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Label Text="¿Olvidaste tu contraseña?" TextColor="#5F42CA" FontFamily="PoppinsBold" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" Margin="0,15,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnForgotPasswordTapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 🟣 MODAL FLOTANTE PARA SELECCIONAR PAÍS (AQUÍ ESTÁ EL CÓDIGO QUE FALTABA) -->
        <Grid x:Name="CountryCodeOverlay" BackgroundColor="#99000000" IsVisible="False" ZIndex="100">
            <Border BackgroundColor="White" Stroke="#37246B" StrokeThickness="1" StrokeShape="RoundRectangle 20" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="260" Padding="25">
                <VerticalStackLayout Spacing="15">

                    <Label Text="País / Región" TextColor="#37246B" FontFamily="PoppinsBold" FontSize="18" HorizontalOptions="Center" Margin="0,0,0,10"/>

                    <Button Text="🇲🇽 +52 (México)" BackgroundColor="#F4EEFF" TextColor="#37246B" FontFamily="PoppinsBold" CornerRadius="12" HeightRequest="50" Clicked="OnCountrySelected"/>
                    <Button Text="🇨🇦 +1 (Canadá / US)" BackgroundColor="#F4EEFF" TextColor="#37246B" FontFamily="PoppinsBold" CornerRadius="12" HeightRequest="50" Clicked="OnCountrySelected"/>

                    <Button Text="Cancelar" BackgroundColor="Transparent" TextColor="#7663B5" FontFamily="PoppinsRegular" Clicked="OnCloseCountryCodeOverlay" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>