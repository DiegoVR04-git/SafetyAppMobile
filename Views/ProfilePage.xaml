<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafetyAppMobile.ProfilePage"
             Title="Mi Perfil"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#5B21B6">

    <Grid>
        <Grid RowDefinitions="Auto, *">

            <!-- ============================================ -->
            <!-- 1. CABECERA MORADA                           -->
            <!-- ============================================ -->
            <VerticalStackLayout Grid.Row="0" Padding="24,52,24,28" Spacing="4">

                <!-- Badge de seguridad -->
                <HorizontalStackLayout Spacing="6" Margin="0,0,0,10">
                    <Label Text="🛡" FontSize="11" VerticalOptions="Center"/>
                    <Label Text="SEGURIDAD PERSONAL"
                           TextColor="#C4B5FD"
                           FontFamily="PoppinsBold"
                           FontSize="10.5"
                           CharacterSpacing="1.5"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Título -->
                <Label Text="Mi Perfil"
                       FontSize="30"
                       FontFamily="PoppinsBold"
                       FontAttributes="Bold"
                       TextColor="White"/>

                <!-- Subtítulo -->
                <Label Text="Actualiza tus datos de acceso y el correo donde tu red recibirá el reporte S.O.S."
                       TextColor="#DDD6FE"
                       FontFamily="PoppinsRegular"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       Margin="0,6,0,0"/>
            </VerticalStackLayout>

            <!-- ============================================ -->
            <!-- 2. CUERPO CON CURVA SUPERIOR                 -->
            <!-- ============================================ -->
            <Border Grid.Row="1"
                    BackgroundColor="#F0EBF9"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 32,32,0,0"
                    Padding="0">

                <ScrollView>
                    <VerticalStackLayout Padding="20,24,20,44" Spacing="16">

                        <!-- ── Avatar + Nombre + Estado ──────────────── -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" Margin="0,4,0,6">

                            <Border Grid.Column="0"
                                    BackgroundColor="#6D28D9"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 26"
                                    HeightRequest="52" WidthRequest="52"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label x:Name="AvatarInitialLabel"
                                       Text="M"
                                       TextColor="White"
                                       FontFamily="PoppinsBold"
                                       FontAttributes="Bold"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label x:Name="HeaderNameLabel"
                                       Text="Melissa"
                                       TextColor="#1A1030"
                                       FontFamily="PoppinsBold"
                                       FontAttributes="Bold"
                                       FontSize="15"/>
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Ellipse Fill="#34D399"
                                             HeightRequest="7" WidthRequest="7"
                                             VerticalOptions="Center"/>
                                    <Label Text="Cuenta activa"
                                           TextColor="#8B7BAE"
                                           FontFamily="PoppinsRegular"
                                           FontSize="12"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- ── Campo 1: NOMBRE COMPLETO ──────────────── -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="NOMBRE COMPLETO"
                                   TextColor="#7C3AED"
                                   FontFamily="PoppinsBold"
                                   FontSize="10.5"
                                   CharacterSpacing="1.2"/>

                            <Border BackgroundColor="White"
                                    Stroke="#E8E0F5"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="14,12">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="#F0EBF9" Stroke="Transparent" StrokeShape="RoundRectangle 12" HeightRequest="38" WidthRequest="38">
                                        <Label Text="👤" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Entry x:Name="NameEntry" Grid.Column="1" Placeholder="Tu nombre completo" TextColor="#1A1030" PlaceholderColor="#C4B5FD" FontFamily="PoppinsRegular" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ── Campo 2: CORREO PERSONAL ──────────────── -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="CORREO PERSONAL (ACCESO)"
                                   TextColor="#7C3AED"
                                   FontFamily="PoppinsBold"
                                   FontSize="10.5"
                                   CharacterSpacing="1.2"/>

                            <Border BackgroundColor="White"
                                    Stroke="#E8E0F5"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="14,12">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="#F0EBF9" Stroke="Transparent" StrokeShape="RoundRectangle 12" HeightRequest="38" WidthRequest="38">
                                        <Label Text="✉️" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Entry x:Name="PersonalEmailEntry" Grid.Column="1" Placeholder="tu@correo.com" Keyboard="Email" TextColor="#1A1030" PlaceholderColor="#C4B5FD" FontFamily="PoppinsRegular" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ── Campo 3: TELÉFONO ──────────────────────── -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="TELÉFONO"
                                   TextColor="#7C3AED"
                                   FontFamily="PoppinsBold"
                                   FontSize="10.5"
                                   CharacterSpacing="1.2"/>

                            <Border BackgroundColor="White"
                                    Stroke="#E8E0F5"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="14,6">
                                <Grid ColumnDefinitions="Auto, Auto, Auto, *" ColumnSpacing="10" VerticalOptions="Center">

                                    <Border Grid.Column="0" BackgroundColor="#F0EBF9" Stroke="Transparent" StrokeShape="RoundRectangle 12" HeightRequest="38" WidthRequest="38">
                                        <Label Text="📞" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- 🟣 NUEVO SELECTOR DE PAÍS PERSONALIZADO -->
                                    <Grid Grid.Column="1" HeightRequest="38" VerticalOptions="Center">
                                        <Border BackgroundColor="#F0EBF9" Stroke="Transparent" StrokeShape="RoundRectangle 10" Padding="8,0">
                                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                                <Label x:Name="SelectedCountryCodeLabel" 
                                                       Text="+52" 
                                                       TextColor="#6D28D9"
                                                       FontFamily="PoppinsBold"
                                                       FontSize="13"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="▼" FontSize="9" TextColor="#8B7BAE" VerticalOptions="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <Button BackgroundColor="Transparent" Clicked="OnOpenCountryCodeTapped" />
                                    </Grid>

                                    <BoxView Grid.Column="2" WidthRequest="1" Color="#E0D5F5" VerticalOptions="Fill" Margin="0,8"/>

                                    <Entry x:Name="PhoneEntry" Grid.Column="3" Placeholder="5512345678" MaxLength="10" Keyboard="Telephone" TextColor="#1A1030" PlaceholderColor="#C4B5FD" FontFamily="PoppinsRegular" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ── Campo 4: CORREO S.O.S ─────────────────── -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="CORREO S.O.S (ALERTAS)"
                                   TextColor="#E5484D"
                                   FontFamily="PoppinsBold"
                                   FontSize="10.5"
                                   CharacterSpacing="1.2"/>

                            <Border BackgroundColor="White"
                                    Stroke="#E8E0F5"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="14,12">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="#FEE2E2" Stroke="Transparent" StrokeShape="RoundRectangle 12" HeightRequest="38" WidthRequest="38">
                                        <Label Text="🚨" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Entry x:Name="SosEmailEntry" Grid.Column="1" Placeholder="emergencia@correo.com" Keyboard="Email" TextColor="#1A1030" PlaceholderColor="#C4B5FD" FontFamily="PoppinsRegular" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ── Botón Guardar Cambios ──────────────────── -->
                        <Button x:Name="SaveBtn"
                                Text="Guardar Cambios"
                                Clicked="OnSaveClicked"
                                BackgroundColor="#5B21B6"
                                TextColor="White"
                                FontSize="15"
                                FontFamily="PoppinsBold"
                                FontAttributes="Bold"
                                CornerRadius="20"
                                HeightRequest="56"
                                Margin="0,12,0,0">
                            <Button.Shadow>
                                <Shadow Brush="#5B21B6" Opacity="0.35" Offset="0,8" Radius="16"/>
                            </Button.Shadow>
                        </Button>

                        <!-- ── Separador + Cerrar Sesión ─────────────── -->
                        <VerticalStackLayout Spacing="12" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="12">
                                <BoxView Grid.Column="0" HeightRequest="1" Color="#E0D5F5" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="CUENTA" TextColor="#B8A5D8" FontFamily="PoppinsBold" FontSize="10.5" CharacterSpacing="1" VerticalOptions="Center"/>
                                <BoxView Grid.Column="2" HeightRequest="1" Color="#E0D5F5" VerticalOptions="Center"/>
                            </Grid>

                            <Button Text="Cerrar Sesión"
                                    Clicked="OnLogoutClicked"
                                    BackgroundColor="White"
                                    TextColor="#EF4444"
                                    BorderColor="#FECACA"
                                    BorderWidth="2"
                                    FontSize="15"
                                    FontFamily="PoppinsBold"
                                    FontAttributes="Bold"
                                    CornerRadius="20"
                                    HeightRequest="54"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- 🟣 MODAL FLOTANTE PARA SELECCIONAR PAÍS -->
        <Grid x:Name="CountryCodeOverlay" 
              BackgroundColor="#99000000" 
              IsVisible="False" 
              ZIndex="100">
            <Border BackgroundColor="White" 
                    Stroke="#37246B" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20" 
                    HorizontalOptions="Center" 
                    VerticalOptions="Center" 
                    WidthRequest="260" 
                    Padding="25">
                <VerticalStackLayout Spacing="15">
                    <Label Text="País / Región" TextColor="#37246B" FontFamily="PoppinsBold" FontSize="18" HorizontalOptions="Center" Margin="0,0,0,10"/>

                    <Button Text="🇲🇽 +52 (México)" BackgroundColor="#F4EEFF" TextColor="#37246B" FontFamily="PoppinsBold" CornerRadius="12" HeightRequest="50" Clicked="OnCountrySelected"/>
                    <Button Text="🇨🇦 +1 (Canadá / US)" BackgroundColor="#F4EEFF" TextColor="#37246B" FontFamily="PoppinsBold" CornerRadius="12" HeightRequest="50" Clicked="OnCountrySelected"/>

                    <Button Text="Cancelar" BackgroundColor="Transparent" TextColor="#7663B5" FontFamily="PoppinsRegular" Clicked="OnCloseCountryCodeOverlay" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>