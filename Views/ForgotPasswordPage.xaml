<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafetyAppMobile.ForgotPasswordPage"
             BackgroundColor="#5F42CA"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- ── CABECERA MORADA ──────────────────────────────────────── -->
        <VerticalStackLayout Grid.Row="0" Padding="25,40,25,30" Spacing="12">
            <HorizontalStackLayout>
                <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#7458D4" Stroke="Transparent" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="‹" TextColor="White" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-3,2,0"/>
                </Border>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="3">
                <Label Text="Recuperar Acceso" FontFamily="PoppinsBold" FontSize="28" FontAttributes="Bold" TextColor="White" CharacterSpacing="-0.5"/>
                <Label Text="Ingresa tu correo para enviarte un código de seguridad." FontFamily="PoppinsRegular" FontSize="14" TextColor="#E2D9F3" LineHeight="1.4"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- ── TARJETA BLANCA FLOTANTE ────────────────────────────── -->
        <Border Grid.Row="1" BackgroundColor="#F6F3FB" Stroke="Transparent" StrokeShape="RoundRectangle 30,30,0,0" Padding="0">
            <VerticalStackLayout Padding="22,40,22,40" Spacing="25">

                <VerticalStackLayout Spacing="8">
                    <Label Text="CORREO ELECTRÓNICO" TextColor="#7663B5" FontFamily="PoppinsBold" FontSize="11" CharacterSpacing="0.5"/>
                    <Border BackgroundColor="White" Stroke="#E8E5F3" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="15,4">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#F4EEFF" Stroke="Transparent" StrokeShape="RoundRectangle 20" HeightRequest="36" WidthRequest="36" VerticalOptions="Center">
                                <Label Text="✉️" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Entry x:Name="EmailEntry"
                                   Grid.Column="1"
                                   Placeholder="tu@correo.com"
                                   PlaceholderColor="#B3A8D4"
                                   TextColor="#2D2440"
                                   FontFamily="PoppinsRegular"
                                   FontSize="15"
                                   Keyboard="Email"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button x:Name="SendCodeBtn"
                        Text="Enviar Código" 
                        Clicked="OnSendCodeClicked"
                        BackgroundColor="#5F42CA" 
                        TextColor="White" 
                        FontSize="16"
                        FontFamily="PoppinsBold"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="55"
                        Margin="0,10,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#5F42CA" Opacity="0.3" Offset="0,6" Radius="10"/>
                    </Button.Shadow>
                </Button>

                <Label x:Name="ErrorLabel" Text="" TextColor="#E5484D" FontFamily="PoppinsBold" FontSize="13" HorizontalOptions="Center" IsVisible="False"/>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>