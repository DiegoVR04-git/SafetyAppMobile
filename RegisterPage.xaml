<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafetyAppMobile.RegisterPage"
             Title="Crear Cuenta"
             BackgroundColor="{StaticResource PulsoFondo}">
    <!-- 🟣 Fondo oficial de Pulso Violeta -->

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Título Principal -->
            <Label Text="Crear Cuenta" 
                   FontSize="32" 
                   FontFamily="PoppinsBold"
                   FontAttributes="Bold" 
                   TextColor="{StaticResource PulsoMoradoProfundo}"
                   HorizontalOptions="Center" 
                   Margin="0,0,0,10"/>

            <!-- 🃏 Tarjeta Blanca para el Formulario de Registro -->
            <Frame BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <!-- Entrada de Nombre -->
                    <Entry x:Name="NameEntry" 
                           Placeholder="Nombre Completo" 
                           PlaceholderColor="{StaticResource PulsoMoradoMedio}"
                           TextColor="{StaticResource PulsoMoradoProfundo}"
                           FontFamily="PoppinsRegular"
                           BackgroundColor="Transparent"/>

                    <Grid ColumnDefinitions="85, *" ColumnSpacing="10">

                        <!-- Selector de Código de País -->
                        <Picker x:Name="CountryCodePicker" 
                                Grid.Column="0" 
                                Title="País" 
                                TextColor="{StaticResource PulsoMoradoProfundo}"
                                TitleColor="{StaticResource PulsoMoradoMedio}"
                                FontFamily="PoppinsRegular"
                                BackgroundColor="Transparent"
                                SelectedIndex="0">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>+52</x:String>
                                    <x:String>+1</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <!-- Entrada de Teléfono -->
                        <Entry x:Name="PhoneEntry" 
                               Grid.Column="1"
                               Placeholder="Número (10 dígitos)" 
                               MaxLength="10"
                               Keyboard="Telephone"
                               PlaceholderColor="{StaticResource PulsoMoradoMedio}"
                               TextColor="{StaticResource PulsoMoradoProfundo}"
                               FontFamily="PoppinsRegular"
                               BackgroundColor="Transparent"/>
                    </Grid>

                    <!-- Entradas de Contraseña -->
                    <Entry x:Name="PasswordEntry" 
                           Placeholder="Contraseña Segura" 
                           IsPassword="True" 
                           PlaceholderColor="{StaticResource PulsoMoradoMedio}"
                           TextColor="{StaticResource PulsoMoradoProfundo}"
                           FontFamily="PoppinsRegular"
                           BackgroundColor="Transparent"/>

                    <Entry x:Name="ConfirmPasswordEntry" 
                           Placeholder="Confirmar Contraseña" 
                           IsPassword="True" 
                           PlaceholderColor="{StaticResource PulsoMoradoMedio}"
                           TextColor="{StaticResource PulsoMoradoProfundo}"
                           FontFamily="PoppinsRegular"
                           BackgroundColor="Transparent"/>

                </VerticalStackLayout>
            </Frame>

            <!-- Botón de Registro -->
            <Button x:Name="RegisterBtn"
                    Text="Unirse a la Red Segura" 
                    Clicked="OnRegisterClicked"
                    BackgroundColor="{StaticResource PulsoMoradoProfundo}" 
                    TextColor="{StaticResource PulsoFondo}" 
                    FontSize="16"
                    FontFamily="PoppinsBold"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,10,0,0"/>

            <!-- Label de Error -->
            <Label x:Name="StatusLabel"
                   Text=""
                   TextColor="{StaticResource PulsoAlertaRoja}"
                   HorizontalOptions="Center"
                   FontFamily="PoppinsBold"
                   FontAttributes="Bold"/>

            <!-- Enlace para Volver al Login -->
            <Label Text="Volver al Login" 
                   TextColor="{StaticResource PulsoMoradoMedio}" 
                   FontFamily="PoppinsBold"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackToLoginTapped" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>