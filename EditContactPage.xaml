<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafetyAppMobile.EditContactPage"
             Title="Editar Contacto"
             BackgroundColor="{StaticResource PulsoFondo}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="25,30,25,30" Spacing="25">

                <!-- Título -->
                <Label Text="Modificar Datos" 
                       FontSize="24" 
                       FontFamily="PoppinsBold"
                       FontAttributes="Bold" 
                       TextColor="{StaticResource PulsoMoradoProfundo}"
                       HorizontalOptions="Center" />

                <!-- 🃏 Tarjeta Blanca Principal -->
                <Border BackgroundColor="White" 
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 25"
                        Padding="20,25">

                    <Border.Shadow>
                        <Shadow Brush="#D1CBE0" Opacity="0.4" Offset="0,4" Radius="10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <!-- 👤 Sección de Foto de Contacto -->
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Border BackgroundColor="#F0EDF9"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 40"
                                    HeightRequest="80" WidthRequest="80"
                                    HorizontalOptions="Center">
                                <Label Text="👤" FontSize="36" TextColor="{StaticResource PulsoMoradoProfundo}" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Cambiar foto de contacto" 
                                   TextColor="{StaticResource PulsoMoradoProfundo}" 
                                   FontFamily="PoppinsBold" 
                                   FontSize="13" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Línea divisoria sutil -->
                        <BoxView HeightRequest="1" Color="#F0EDF9" Margin="0,5,0,5"/>

                        <!-- Input: Nombre del Contacto -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nombre del Contacto" TextColor="{StaticResource PulsoMoradoMedio}" FontFamily="PoppinsRegular" FontSize="12"/>

                            <!-- Caja contenedora con fondo lavanda claro -->
                            <Border BackgroundColor="#F4F2FC" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="15,4">
                                <Entry x:Name="NameEntry" 
                                       TextColor="{StaticResource PulsoMoradoProfundo}"
                                       FontFamily="PoppinsRegular"
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Inputs: País y Teléfono (Lado a lado) -->
                        <Grid ColumnDefinitions="0.38*, 0.62*" ColumnSpacing="12">

                            <!-- Selector de País -->
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="País" TextColor="{StaticResource PulsoMoradoMedio}" FontFamily="PoppinsRegular" FontSize="12"/>
                                <Border BackgroundColor="#F4F2FC" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="10,4">
                                    <Picker x:Name="CountryCodePicker" 
                Title="País" 
                TextColor="{StaticResource PulsoMoradoProfundo}"
                TitleColor="{StaticResource PulsoMoradoMedio}"
                FontFamily="PoppinsRegular"
                BackgroundColor="Transparent"
                SelectedIndex="0">

                                        <!-- Cambiamos la forma de declarar los ítems para que Android los lea bien -->
                                        <Picker.Items>
                                            <x:String>+52</x:String>
                                            <x:String>+1</x:String>
                                        </Picker.Items>

                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Entrada de Teléfono -->
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Teléfono (10 dígitos)" TextColor="{StaticResource PulsoMoradoMedio}" FontFamily="PoppinsRegular" FontSize="12"/>
                                <Border BackgroundColor="#F4F2FC" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="15,4">
                                    <Entry x:Name="PhoneEntry"
                                           Placeholder="5543210987" 
                                           MaxLength="10" 
                                           Keyboard="Telephone"
                                           TextColor="{StaticResource PulsoMoradoProfundo}" 
                                           PlaceholderColor="{StaticResource PulsoMoradoMedio}" 
                                           FontFamily="PoppinsRegular"
                                           BackgroundColor="Transparent"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ==============================  ZONA DE BOTONES ============================== -->
                <VerticalStackLayout Spacing="12" Margin="0,5,0,0">

                    <Button x:Name="SaveBtn"
                            Text="Guardar Cambios" 
                            Clicked="OnSaveClicked"
                            BackgroundColor="{StaticResource PulsoMoradoProfundo}" 
                            TextColor="{StaticResource PulsoFondo}" 
                            FontSize="16"
                            FontFamily="PoppinsBold"
                            FontAttributes="Bold"
                            CornerRadius="25"
                            HeightRequest="55"/>

                    <Label x:Name="StatusLabel"
                           Text=""
                           TextColor="{StaticResource PulsoAlertaRoja}"
                           HorizontalOptions="Center"
                           FontFamily="PoppinsBold"
                           FontAttributes="Bold"
                           Margin="0,-5,0,-5"/>

                    <Button Text="Cancelar" 
                            Clicked="OnCancelClicked"
                            BackgroundColor="Transparent" 
                            TextColor="{StaticResource PulsoMoradoProfundo}" 
                            FontFamily="PoppinsBold"
                            FontAttributes="Bold"
                            HeightRequest="40"/>
                </VerticalStackLayout>

                <!-- Botón Eliminar Contacto -->
                <Button x:Name="DeleteBtn"
                        Text="🗑️ Eliminar Contacto" 
                        Clicked="OnDeleteClicked"
                        BackgroundColor="Transparent" 
                        TextColor="{StaticResource PulsoAlertaRoja}" 
                        FontSize="15"
                        FontFamily="PoppinsBold"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="45"
                        Margin="0,15,0,20"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==============================  🔴 OVERLAY DE ALERTA DE ELIMINACIÓN  ============================== -->
        <Grid x:Name="CustomDeleteOverlay" 
              BackgroundColor="#99000000" 
              IsVisible="False"
              Opacity="0"
              ZIndex="100">

            <Border BackgroundColor="White"
                    Stroke="{StaticResource PulsoAlertaRoja}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="25">

                <VerticalStackLayout Spacing="15">
                    <Label Text="⚠️" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="Advertencia" 
                           TextColor="{StaticResource PulsoAlertaRoja}" 
                           FontFamily="PoppinsBold" 
                           FontSize="20" 
                           HorizontalOptions="Center" />

                    <Label Text="¿Estás seguro de que quieres eliminar a este contacto de tu red de emergencia? Esta acción no se puede deshacer." 
                           TextColor="{StaticResource PulsoMoradoMedio}" 
                           FontFamily="PoppinsRegular"
                           FontSize="14" 
                           HorizontalTextAlignment="Center" />

                    <VerticalStackLayout Spacing="10" Margin="0,15,0,0">
                        <Button Text="Sí, Eliminar" 
                                BackgroundColor="{StaticResource PulsoAlertaRoja}" 
                                TextColor="White" 
                                CornerRadius="12"
                                FontFamily="PoppinsBold"
                                HeightRequest="50"
                                Clicked="OnConfirmDeleteClicked" />

                        <Button Text="Cancelar" 
                                BackgroundColor="Transparent" 
                                TextColor="{StaticResource PulsoMoradoMedio}"
                                FontFamily="PoppinsRegular"
                                HeightRequest="50"
                                Clicked="OnCancelDeleteAlertClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>