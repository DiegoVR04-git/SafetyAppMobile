<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="SafetyAppMobile.DashboardPage"
             Title="Central de Alertas"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PulsoFondo}">

    <!-- Esto pone el botón de Salir nativamente en la esquina superior derecha de la barra blanca -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" Order="Primary" />
    </ContentPage.ToolbarItems>

    <!-- 🌟 NUEVO GRID PRINCIPAL: Envuelve el ScrollView y la Alerta para que se superpongan -->
    <Grid>

        <!-- ==============================  TODO TU CONTENIDO ORIGINAL  ============================== -->
        <ScrollView>
            <Grid Padding="20,15,20,40" RowDefinitions="Auto, Auto, Auto, Auto, *" RowSpacing="15">

                <!-- 0. MENSAJE DE BIENVENIDA -->
                <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="2" Margin="0,0,0,5">
                    <Label x:Name="GreetingLabel" Text="Bienvenida de Vuelta" FontSize="28" FontFamily="PoppinsBold" FontAttributes="Bold" TextColor="#37246B" HorizontalOptions="Center" />
                    <Label Text="Tu red de apoyo está cuidando tus pasos." FontSize="14" TextColor="#7663B5" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- 1. INDICADOR DE ESTADO EN PÍLDORA -->
                <Border Grid.Row="1" Stroke="#E8E8E8" StrokeThickness="1" StrokeShape="RoundRectangle 20" BackgroundColor="#FFFFFF" Padding="20,12" HorizontalOptions="Center" Margin="0,5,0,10">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05" />
                    </Border.Shadow>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <skia:SKLottieView x:Name="StatusLottie"
                                           Source="shield.json"
                                           RepeatCount="-1"
                                           HeightRequest="30"
                                           WidthRequest="30"
                                           VerticalOptions="Center" />

                        <Label x:Name="StatusLabel" Text="Sistema Listo y Seguro" FontSize="14" FontFamily="PoppinsBold" FontAttributes="Bold" TextColor="#2E7D32" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- 2. EL PROTAGONISTA: BOTÓN S.O.S -->
                <Grid Grid.Row="2" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="340" HeightRequest="340">

                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 160" BackgroundColor="#FFFFFF" WidthRequest="320" HeightRequest="320" HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.05" />
                        </Border.Shadow>
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 130" BackgroundColor="#FAFAFA" WidthRequest="260" HeightRequest="260" HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,5" Radius="15" Opacity="0.08" />
                        </Border.Shadow>
                    </Border>

                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 105" BackgroundColor="Transparent" WidthRequest="210" HeightRequest="210" HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource PulsoAlertaRoja}" Offset="0,0" Radius="40" Opacity="0.3" />
                        </Border.Shadow>
                    </Border>

                    <Button x:Name="PanicButton" 
                            Text="S.O.S" 
                            FontSize="42" 
                            Padding="0"
                            FontFamily="PoppinsBold"
                            FontAttributes="Bold" 
                            TextColor="White" 
                            CornerRadius="100" 
                            WidthRequest="200" 
                            HeightRequest="200" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"
                            Pressed="OnPanicButtonPressed" 
                            Released="OnPanicButtonReleased">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF5252" Offset="0.0" />
                                <GradientStop Color="{StaticResource PulsoAlertaRoja}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource PulsoAlertaRoja}" Offset="0,8" Radius="20" Opacity="0.4" />
                        </Button.Shadow>
                    </Button>

                    <ProgressBar x:Name="HoldProgressBar" 
                                 Progress="0" 
                                 ProgressColor="{StaticResource PulsoAlertaRoja}" 
                                 BackgroundColor="#E0E0E0" 
                                 HeightRequest="6" 
                                 WidthRequest="130" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="End" 
                                 Margin="0,0,0,25"
                                 Opacity="0" />
                </Grid>

                <!-- 3. BOTÓN DE 'ESTOY A SALVO' -->
                <Button x:Name="SafetyButton" 
                        Grid.Row="3"
                        Text="✅ Estoy a Salvo" 
                        Clicked="OnSafetyButtonClicked" 
                        TextColor="White" 
                        IsVisible="False" 
                        HeightRequest="65" 
                        CornerRadius="32" 
                        WidthRequest="280" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center" 
                        FontFamily="PoppinsBold"
                        FontAttributes="Bold" 
                        FontSize="18"
                        BorderColor="#2E7D32"
                        BorderWidth="1">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4CAF50" Offset="0.0" />
                            <GradientStop Color="#2E7D32" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="#4CAF50" Offset="0,10" Radius="20" Opacity="0.5" />
                    </Button.Shadow>
                </Button>

                <!-- 4. MAPA TIPO WIDGET IOS -->
                <Border Grid.Row="4" StrokeThickness="0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 25" HeightRequest="220" Margin="0,5,0,0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.1" />
                    </Border.Shadow>

                    <Grid>
                        <ContentView IsClippedToBounds="True">
                            <maps:Map x:Name="UserMap" IsShowingUser="True" MapType="Street" Margin="0" />
                        </ContentView>

                        <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="15,15,0,0" BackgroundColor="#E6FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,6">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="📍" FontSize="12" VerticalOptions="Center" />
                                <Label Text="Ubicación en Tiempo Real" TextColor="{StaticResource PulsoMoradoProfundo}" FontFamily="PoppinsBold" FontAttributes="Bold" FontSize="11" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollView>

        <!-- ==============================  💜 OVERLAY DE ALERTA PERSONALIZADA  ============================== -->
        <Grid x:Name="CustomAlertOverlay" 
              BackgroundColor="#99000000" 
              IsVisible="False" 
              ZIndex="100">

            <Border BackgroundColor="White"
                    Stroke="#37246B"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="320"
                    Padding="25">

                <VerticalStackLayout Spacing="15">
                    <!-- Icono y Título -->
                    <Label Text="⚠️" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="Acción Requerida" 
                           TextColor="#37246B" 
                           FontFamily="PoppinsBold" 
                           FontSize="20" 
                           HorizontalOptions="Center" />

                    <!-- Mensaje -->
                    <Label Text="Para usar el botón S.O.S. necesitas registrar al menos un contacto de emergencia que reciba tus alertas." 
                           TextColor="#7663B5" 
                           FontFamily="PoppinsRegular"
                           FontSize="14" 
                           HorizontalTextAlignment="Center" />

                    <!-- Botones -->
                    <VerticalStackLayout Spacing="10" Margin="0,15,0,0">
                        <Button Text="Añadir Contacto" 
                                BackgroundColor="#37246B" 
                                TextColor="White" 
                                CornerRadius="12"
                                FontFamily="PoppinsBold"
                                Clicked="OnGoToContactsClicked" />

                        <Button Text="Cancelar" 
                                BackgroundColor="Transparent" 
                                TextColor="#7663B5"
                                FontFamily="PoppinsRegular"
                                Clicked="OnCancelAlertClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>